{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Interview rooms created",
      "type": "timeseries",
      "targets": [
        {
          "expr": "interview_rooms_created_total{environment=~\"$environment\",deployed_version=~\"$deployed_version\"}",
          "legendFormat": "rooms",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Active interview participants",
      "type": "timeseries",
      "targets": [
        {
          "expr": "active_interview_participants{environment=~\"$environment\",deployed_version=~\"$deployed_version\"}",
          "legendFormat": "participants",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Canvas elements created",
      "type": "timeseries",
      "targets": [
        {
          "expr": "canvas_elements_created_total{environment=~\"$environment\",deployed_version=~\"$deployed_version\"}",
          "legendFormat": "elements",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Component creation failures",
      "type": "timeseries",
      "targets": [
        {
          "expr": "component_creation_failures_total{environment=~\"$environment\",deployed_version=~\"$deployed_version\"}",
          "legendFormat": "failures",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["interview-canvas", "otel"],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "multi": true,
        "query": "label_values(environment)",
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "deployed_version",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "includeAll": true,
        "multi": true,
        "query": "label_values(deployed_version)",
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "title": "Interview Canvas metrics",
  "uid": "interview-canvas-metrics"
}
